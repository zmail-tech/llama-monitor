# Llama.cpp Monitor — Example Environment Variables
# Copy to .env and replace with your actual values.

# Instance 1
LLAMA_INSTANCE_1_URL=http://192.168.1.210:8000
LLAMA_INSTANCE_1_KEY=your-api-key-here
LLAMA_INSTANCE_1_LABEL=llama-2

# Instance 2
LLAMA_INSTANCE_2_URL=http://192.168.1.229:8000
LLAMA_INSTANCE_2_KEY=your-api-key-here
LLAMA_INSTANCE_2_LABEL=llama-1

# Add more instances as needed (3, 4, ...)
# LLAMA_INSTANCE_3_URL=...
# LLAMA_INSTANCE_3_KEY=...
# LLAMA_INSTANCE_3_LABEL=...

# OpenRouter API key — for cost comparison feature
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxx
